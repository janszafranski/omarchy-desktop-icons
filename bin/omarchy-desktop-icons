#!/usr/bin/env bash
# omarchy-desktop-icons — start / stop / toggle the desktop icon grid.
#
#   omarchy-desktop-icons           start it (stays in the foreground)
#   omarchy-desktop-icons start     same
#   omarchy-desktop-icons toggle    show/hide the overlay; starts it if stopped
#   omarchy-desktop-icons open      show the overlay; starts it if stopped
#   omarchy-desktop-icons stop      quit the running instance
#   omarchy-desktop-icons status    is it running?
#   omarchy-desktop-icons edit      open the config in $EDITOR
set -euo pipefail

APPDIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-desktop-icons/config.json"

if ! command -v qs >/dev/null 2>&1; then
    echo "omarchy-desktop-icons: 'qs' (quickshell) is not installed." >&2
    echo "  Arch/Omarchy:  yay -S quickshell        # or: yay -S quickshell-git" >&2
    exit 1
fi

running() { qs -p "$APPDIR" ipc show >/dev/null 2>&1; }

# True if ensure_running had to cold-start the instance.
cold_started=0

# `toggle` and `open` are IPC calls into a running instance, so on their own
# they can't recover from the right-click menu's Quit — and with no tray icon
# or taskbar entry that would leave a terminal as the only way back. Start one
# if there isn't one.
ensure_running() {
    running && return 0
    setsid qs -p "$APPDIR" --no-duplicate >/dev/null 2>&1 &
    cold_started=1
    for _ in $(seq 50); do
        running && return 0
        sleep 0.1
    done
    echo "omarchy-desktop-icons: started it, but it never answered on IPC." >&2
    echo "  Run 'omarchy-desktop-icons' in a terminal to see the error." >&2
    return 1
}

case "${1:-start}" in
    start)  exec qs -p "$APPDIR" --no-duplicate ;;
    toggle)
        ensure_running
        # A cold start already draws the grid on the desktop, but that is the
        # bottom layer and usually covered. Show the overlay so the keystroke
        # always does something visible.
        if [ "$cold_started" = 1 ]; then
            exec qs -p "$APPDIR" ipc call desktop open
        else
            exec qs -p "$APPDIR" ipc call desktop toggle
        fi
        ;;
    open)
        ensure_running
        exec qs -p "$APPDIR" ipc call desktop open
        ;;
    close)  exec qs -p "$APPDIR" ipc call desktop close ;;
    reload) exec qs -p "$APPDIR" ipc call desktop reload ;;
    stop)   exec qs -p "$APPDIR" kill ;;
    edit)   exec "${VISUAL:-${EDITOR:-nano}}" "$CONFIG" ;;
    status)
        if running; then
            echo "running (config: $CONFIG)"
        else
            echo "not running"
            exit 1
        fi
        ;;
    -h|--help|help)
        sed -n '2,10p' "$(readlink -f "$0")" | sed 's/^# \{0,1\}//'
        ;;
    *)
        echo "omarchy-desktop-icons: unknown command '$1' (try --help)" >&2
        exit 2
        ;;
esac
